{
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/**/*.test.ts"],
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "types": ["vitest/globals", "jsdom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
