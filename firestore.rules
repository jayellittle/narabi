rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // users 컬렉션: 사용자 프로필 정보
    // ============================================
    match /users/{userId} {

      // 읽기: 자신의 프로필만 읽기 가능
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // 생성: 인증된 사용자가 자신의 UID로만 생성 가능
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // 수정: 자신의 프로필만 수정 가능
      allow update: if request.auth != null
                    && request.auth.uid == userId;

      // 삭제: 자신의 프로필만 삭제 가능
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // ============================================
    // stores 컬렉션: 점포 정보
    // ============================================
    match /stores/{storeId} {

      // 단일 문서 읽기: 점포 소유자만 접근 가능
      // 수정 이유: URL만 알면 누구나 접근 가능했던 문제 해결
      allow get: if request.auth != null
                 && resource.data.ownerId == request.auth.uid;

      // 쿼리/목록 조회: 인증된 사용자만 가능
      // 클라이언트에서 where('ownerId', '==', uid) 필터 사용하므로 자신의 stores만 조회
      // 실제 문서 내용은 get 규칙으로 보호됨
      allow list: if request.auth != null;

      // 생성: 인증된 사용자가 자신을 ownerId로 설정한 경우만
      // 필수 필드 검증: name, address, phoneNumber, ownerId, createdAt
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['name', 'address', 'phoneNumber', 'ownerId', 'createdAt']);

      // 수정: 점포 소유자만, ownerId는 변경 불가
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;

      // 삭제: 점포 소유자만
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // ============================================
      // waitingList 서브컬렉션: 대기열 정보
      // ============================================
      match /waitingList/{customerId} {

        // list 쿼리: 점포 소유자만 가능
        // 수정 이유: 전체 대기열 목록은 점포 관리자만 볼 수 있어야 함
        allow list: if request.auth != null
                    && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;

        // get (단일 문서 읽기): 점포 소유자 또는 누구나
        // 수정 이유: 대기 중인 손님이 customerId를 알고 있으면 자신의 순번 확인 가능
        // 보안: customerId(문서 ID)를 모르면 접근 불가
        allow get: if request.auth != null
                   && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid
                   || true;

        // 생성: 아무도 직접 생성 불가 (Cloud Function을 통해서만)
        // Cloud Function은 Admin SDK를 사용하므로 보안 규칙 우회
        // 수정 이유: 클라이언트에서 직접 대기열 등록 방지
        allow create: if false;

        // 수정: 점포 소유자만 (status 변경 등)
        allow update: if request.auth != null
                      && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;

        // 삭제: 점포 소유자만
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
