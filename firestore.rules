rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /stores/{storeId} {
        allow read: if true;    // 누구나 가게 정보 조회 가능
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

        match /waitingList/{customerId} {
            allow read: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId;
            allow create: if true;
            allow update: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId;
            allow delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId;
  }
}
