rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // 헬퍼 함수
    // ========================================

    // 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 매장 오너인지 확인
    function isStoreOwner(storeId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // 매장 스태프인지 확인 (오너만 허용으로 간소화)
    function isStoreStaff(storeId) {
      return isStoreOwner(storeId);
    }

    // ========================================
    // 매장 (stores) 컬렉션
    // ========================================
    match /stores/{storeId} {
      // 읽기: 모든 인증된 사용자
      allow read: if isAuthenticated();

      // 생성: 인증된 사용자 (ownerId 확인)
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid;

      // 업데이트: 오너 또는 스태프
      allow update: if isStoreOwner(storeId);

      // 삭제: 오너만
      allow delete: if isStoreOwner(storeId);

      // ========================================
      // 대기 목록 (waitingList) 서브컬렉션
      // ========================================
      match /waitingList/{customerId} {
        // 읽기: 모든 사용자 (QR 코드로 등록하는 고객 포함)
        allow read: if true;

        // 생성: Functions에서만 (LINE 인증 후)
        allow create: if false;

        // 업데이트: 스태프만 (호출, 취소, 완료 처리)
        allow update: if isStoreStaff(storeId);

        // 삭제: 스태프만
        allow delete: if isStoreStaff(storeId);
      }
    }

    // ========================================
    // 매장 참여 요청 (storeJoinRequests) 컬렉션
    // ========================================
    match /storeJoinRequests/{requestId} {
      // 개별 문서 읽기 (get): 요청한 사용자 또는 해당 매장의 오너
      allow get: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isStoreOwner(resource.data.storeId)
      );

      // 컬렉션 쿼리 (list): 인증된 사용자 (where 절로 필터링됨)
      allow list: if isAuthenticated();

      // 생성: 인증된 사용자 (userId 필수)
      allow create: if isAuthenticated() &&
                       'userId' in request.resource.data &&
                       request.resource.data.userId == request.auth.uid;

      // 업데이트: 매장 오너 또는 요청한 사용자 본인 (재신청용)
      allow update: if isAuthenticated() && (
        isStoreOwner(resource.data.storeId) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid &&
         'userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );

      // 삭제: 요청한 사용자 또는 매장 오너
      allow delete: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isStoreOwner(resource.data.storeId)
      );
    }

    // ========================================
    // 사용자 프로필 (users) 컬렉션 (선택사항)
    // ========================================
    match /users/{userId} {
      // 읽기: 본인만
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // 생성/업데이트: 본인만
      allow create, update: if isAuthenticated() && request.auth.uid == userId;

      // 삭제: 본인만
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ========================================
    // 관리자 전용 (admins) 컬렉션
    // ========================================
    match /admins/{adminId} {
      // 읽기/쓰기: 관리자만 (별도 관리 필요)
      allow read, write: if false;
    }

    // ========================================
    // 기타 모든 문서는 기본적으로 접근 불가
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
